# Hashed image derivatives can be cached for a year. Apache applies this when
# mod_headers is enabled. Brotli or gzip covers HTML, CSS and JavaScript when
# those modules are installed. Already-compressed images are left alone.

<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/media/experience/r/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^/media/experience/seq/#">
        Header set Cache-Control "public, max-age=604800"
    </If>
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
