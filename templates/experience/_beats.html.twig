{% set sceneCount = 0 %}
{% for beat in beats %}
    {% if beat.type == 'scene' %}
        {% set sceneCount = sceneCount + 1 %}
    {% endif %}
    {% set eagerScene = eager|default(false) and beat.type == 'scene' and sceneCount <= 2 %}
    {% if beat.type == 'hub' %}
        {% set hub = beat.hub %}
        <section class="hub{{ hub.ledePt ? ' hub--break' : '' }}" id="{{ hub.id }}" data-hub>
            {% if hub.image %}
                <img class="hub__bg" src="{{ asset('media/experience/' ~ hub.image) }}" alt="" width="1280" height="720" decoding="async">
                <div class="hub__shade" aria-hidden="true"></div>
            {% endif %}
            <div class="hub__inner">
                <h2 class="script hub__title"><span class="t-pt">{{ hub.titlePt }}</span><span class="t-en">{{ hub.titleEn }}</span></h2>
                {% if hub.ledePt %}
                    <p class="hub__lede"><span class="t-pt">{{ hub.ledePt }}</span><span class="t-en">{{ hub.ledeEn }}</span></p>
                {% endif %}
                <div class="hub__cards">
                    {% for card in hub.cards %}
                        <a
                            class="hub-card"
                            href="{{ card.branch ? '#branch-' ~ card.branch : card.href }}"
                            {% if card.branch %}
                                data-branch="{{ card.branch }}"
                                data-action="experience#openBranch"
                            {% else %}
                                data-action="experience#jump"
                            {% endif %}
                        >
                            <img src="{{ asset('media/experience/' ~ card.image) }}" alt="{{ card.altPt }}" data-alt-pt="{{ card.altPt }}" data-alt-en="{{ card.altEn }}" width="640" height="360" loading="lazy" decoding="async">
                            <span class="hub-card__text">
                                <span class="hub-card__title"><span class="t-pt">{{ card.titlePt }}</span><span class="t-en">{{ card.titleEn }}</span></span>
                                {% if card.linePt %}
                                    <span class="hub-card__line"><span class="t-pt">{{ card.linePt }}</span><span class="t-en">{{ card.lineEn }}</span></span>
                                {% endif %}
                            </span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% elseif beat.type == 'fork' %}
        {% set fork = beat.fork %}
        <section class="fork" id="{{ fork.id }}" data-fork>
            <img class="fork__bg" src="{{ asset('media/experience/' ~ fork.still) }}" alt="{{ fork.altPt }}" data-alt-pt="{{ fork.altPt }}" data-alt-en="{{ fork.altEn }}" width="1280" height="720" decoding="async">
            <div class="fork__shade" aria-hidden="true"></div>
            <div class="fork__copy">
                <h2 class="script"><span class="t-pt">{{ fork.titlePt }}</span><span class="t-en">{{ fork.titleEn }}</span></h2>
                {% if fork.bodyPt %}
                    <p class="body"><span class="t-pt">{{ fork.bodyPt }}</span><span class="t-en">{{ fork.bodyEn }}</span></p>
                {% endif %}
                <div class="fork__actions">
                    <a class="pill" href="{{ fork.discoverHref }}" data-action="experience#jump"><span class="t-pt">{{ fork.discoverPt }}</span><span class="t-en">{{ fork.discoverEn }}</span></a>
                    <a class="pill pill--ghost" href="#reservas" data-action="experience#leaveBranch"><span class="t-pt">Reservar agora</span><span class="t-en">Book now</span></a>
                </div>
                {% if fork.rajaaram %}
                    <p class="chapter-nav chapter-nav--center">
                        <a href="{{ links.rajaaram }}" target="_blank" rel="noopener noreferrer"><span class="t-pt">Conhecer rajaaram.com.br</span><span class="t-en">Visit rajaaram.com.br</span></a>
                        <a href="{{ links.rajaaramWa }}" target="_blank" rel="noopener noreferrer">WhatsApp Rajaaram</a>
                    </p>
                    <p class="small">{{ links.rajaaramPhone }}</p>
                {% endif %}
            </div>
        </section>
    {% elseif beat.type == 'reel' %}
        {% set reel = beat.reel %}
        <section class="reel" id="{{ reel.id }}" data-reel>
            <div class="reel__track">
                {% for slide in reel.slides %}
                    <article class="reel__slide" id="{{ slide.id }}" data-scene="{{ slide.id }}">
                        <img class="reel__still" src="{{ asset('media/experience/' ~ slide.still) }}" alt="{{ slide.altPt }}" data-alt-pt="{{ slide.altPt }}" data-alt-en="{{ slide.altEn }}" width="1280" height="720" decoding="async" loading="lazy">
                        {% if slide.video %}
                            <video class="reel__video" data-src="{{ asset('media/experience/' ~ slide.video) }}" poster="{{ asset('media/experience/' ~ slide.poster) }}" muted playsinline loop preload="metadata" disablepictureinpicture disableremoteplayback tabindex="-1" aria-hidden="true"></video>
                        {% endif %}
                        <div class="scene__shade" aria-hidden="true"></div>
                        {% if slide.titlePt or slide.bodyPt %}
                            <div class="reel__copy">
                                {% if slide.titlePt %}
                                    <h2 class="script"><span class="t-pt">{{ slide.titlePt }}</span><span class="t-en">{{ slide.titleEn }}</span></h2>
                                {% endif %}
                                {% if slide.bodyPt %}
                                    <p class="body"><span class="t-pt">{{ slide.bodyPt }}</span><span class="t-en">{{ slide.bodyEn }}</span></p>
                                {% endif %}
                            </div>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
            <div class="reel__dots" aria-hidden="true">
                {% for slide in reel.slides %}
                    <button type="button" class="reel__dot" data-action="experience#reelDot" data-slide="{{ slide.id }}"><span class="t-pt">{{ loop.index }}</span><span class="t-en">{{ loop.index }}</span></button>
                {% endfor %}
            </div>
        </section>
    {% else %}
        {% set scene = beat.scene %}
        <section
            class="scene scene--{{ scene.align }}{{ scene.hero ? ' scene--hero is-current is-settled' : '' }}{{ scene.finale ? ' scene--finale' : '' }}{{ scene.pause ? ' scene--pause' : '' }}"
            id="{{ scene.anchor ?: scene.id }}"
            data-scene="{{ scene.id }}"
            data-experience-target="scene"
            data-travel="{{ scene.travel }}"
            {% if scene.hero %}data-hero="1"{% endif %}
            {% if scene.finale %}data-finale="1"{% endif %}
            {% if scene.brief %}data-brief="1"{% endif %}
            aria-label="{{ scene.altPt }}"
            data-alt-pt="{{ scene.altPt }}"
            data-alt-en="{{ scene.altEn }}"
        >
            <div class="scene__pin">
                <img
                    class="scene__still"
                    src="{{ asset('media/experience/' ~ scene.still) }}"
                    alt="{{ scene.altPt }}"
                    data-alt-pt="{{ scene.altPt }}"
                    data-alt-en="{{ scene.altEn }}"
                    width="1280"
                    height="720"
                    decoding="async"
                    {% if eagerScene %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
                >
                {% if scene.video %}
                <video
                    class="scene__video"
                    data-experience-target="video"
                    {% if eagerScene %}
                        src="{{ asset('media/experience/' ~ scene.video) }}"
                        preload="{{ sceneCount == 1 ? 'auto' : 'metadata' }}"
                    {% else %}
                        data-src="{{ asset('media/experience/' ~ scene.video) }}"
                        preload="metadata"
                    {% endif %}
                    poster="{{ asset('media/experience/' ~ scene.poster) }}"
                    muted
                    playsinline
                    loop
                    disablepictureinpicture
                    disableremoteplayback
                    tabindex="-1"
                    aria-hidden="true"
                ></video>
                {% endif %}
                <button type="button" class="scene__expand" data-action="experience#expand" aria-label="Ampliar"><span class="t-pt">Ampliar</span><span class="t-en">Expand</span></button>
                <div class="scene__shade" aria-hidden="true"></div>

                {% if scene.titlePt or scene.bodyPt or scene.kickerPt or scene.hero or scene.finale or scene.backHub or scene.choices or scene.cta %}
                    <div class="scene__copy" data-copy>
                        {% if scene.kickerPt %}
                            <p class="kicker"><span class="t-pt">{{ scene.kickerPt }}</span><span class="t-en">{{ scene.kickerEn }}</span></p>
                        {% endif %}

                        {% if scene.hero %}
                            <p class="view-line"><span class="t-pt">A melhor vista do mundo</span><span class="t-en">The best view in the world</span></p>
                        {% endif %}

                        {% if scene.titlePt %}
                            {% if scene.hero %}
                                <h1 class="script"><span class="t-pt">{{ scene.titlePt }}</span><span class="t-en">{{ scene.titleEn }}</span></h1>
                            {% else %}
                                <h2 class="script"><span class="t-pt">{{ scene.titlePt }}</span><span class="t-en">{{ scene.titleEn }}</span></h2>
                            {% endif %}
                        {% endif %}

                        {% if scene.bodyPt %}
                            <p class="body"><span class="t-pt">{{ scene.bodyPt }}</span><span class="t-en">{{ scene.bodyEn }}</span></p>
                        {% endif %}
                        {% if scene.smallPt %}
                            <p class="small"><span class="t-pt">{{ scene.smallPt }}</span><span class="t-en">{{ scene.smallEn }}</span></p>
                        {% endif %}
                        {% if scene.noticePt %}
                            <p class="notice"><span class="t-pt">{{ scene.noticePt }}</span><span class="t-en">{{ scene.noticeEn }}</span></p>
                        {% endif %}

                        {% if scene.pricePt %}
                            <p class="price"><span class="t-pt">{{ scene.pricePt }}</span><span class="t-en">{{ scene.priceEn }}</span></p>
                        {% endif %}
                        {% if scene.metaPt %}
                            <p class="meta"><span class="t-pt">{{ scene.metaPt }}</span><span class="t-en">{{ scene.metaEn }}</span></p>
                        {% endif %}

                        {% if scene.hero or scene.finale %}
                            <a class="pill js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">
                                <span class="t-pt">RESERVAR O DOMO</span><span class="t-en">BOOK THE DOME</span>
                            </a>
                        {% endif %}

                        {% if scene.finale %}
                            <p class="quiet-links">
                                <a class="js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">WhatsApp {{ links.phone }}</a>
                                <span aria-hidden="true">·</span>
                                <a href="{{ links.airbnb }}" target="_blank" rel="noopener noreferrer">Airbnb</a>
                            </p>
                        {% endif %}

                        {% if scene.cta == 'retreat' %}
                            <p class="chapter-nav">
                                <a class="js-wa" href="{{ links.eventPt }}" data-wa-pt="{{ links.eventPt }}" data-wa-en="{{ links.eventEn }}" target="_blank" rel="noopener noreferrer"><span class="t-pt">Falar no WhatsApp</span><span class="t-en">Talk on WhatsApp</span></a>
                                <a href="#hub-break" data-action="experience#leaveBranch"><span class="t-pt">Voltar às escolhas ↺</span><span class="t-en">Back to choices ↺</span></a>
                                <a href="#reservas" data-action="experience#leaveBranch"><span class="t-pt">Reservar agora</span><span class="t-en">Book now</span></a>
                            </p>
                            <p class="small">{{ links.phone }}</p>
                        {% elseif scene.cta == 'rajaaram' %}
                            <div class="fork__actions">
                                <a class="pill" href="{{ links.rajaaram }}" target="_blank" rel="noopener noreferrer"><span class="t-pt">Conhecer rajaaram.com.br</span><span class="t-en">Visit rajaaram.com.br</span></a>
                                <a class="pill pill--ghost" href="{{ links.rajaaramWa }}" target="_blank" rel="noopener noreferrer">WhatsApp Rajaaram</a>
                            </div>
                            <p class="small">{{ links.rajaaramPhone }}</p>
                            <p class="chapter-nav">
                                <a href="#hub-break" data-action="experience#leaveBranch"><span class="t-pt">Voltar às escolhas ↺</span><span class="t-en">Back to choices ↺</span></a>
                                <a href="#reservas" data-action="experience#leaveBranch"><span class="t-pt">Reservar o domo</span><span class="t-en">Book the dome</span></a>
                            </p>
                        {% elseif scene.backHub or scene.choices %}
                            <p class="chapter-nav">
                                {% if scene.backHub %}
                                    <a href="#{{ scene.backHub }}" data-action="experience#jump"><span class="t-pt">Ver outro canto ↺</span><span class="t-en">See another corner ↺</span></a>
                                {% endif %}
                                {% if scene.choices %}
                                    <a href="#hub-break" data-action="experience#leaveBranch"><span class="t-pt">Voltar às escolhas ↺</span><span class="t-en">Back to choices ↺</span></a>
                                    <a href="#reservas" data-action="experience#leaveBranch"><span class="t-pt">Reservar agora</span><span class="t-en">Book now</span></a>
                                {% endif %}
                            </p>
                        {% endif %}
                    </div>
                {% endif %}
                {% if scene.finePt %}
                    <p class="fine"><span class="t-pt">{{ scene.finePt }}</span><span class="t-en">{{ scene.fineEn }}</span></p>
                {% endif %}
            </div>
        </section>
    {% endif %}
{% endfor %}
