{% extends 'base.html.twig' %}

{% block title %}Domo Xangô · Domo geodésico na Chapada dos Veadeiros{% endblock %}
{% block title_attrs %} data-pt="Domo Xangô · Domo geodésico na Chapada dos Veadeiros" data-en="Domo Xangô · Geodesic dome in Chapada dos Veadeiros"{% endblock %}

{% block meta %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Domo geodésico privativo em Alto Paraíso de Goiás, com deck de 340 m², pirâmide e a serra à frente. Hospedagem para 5 pessoas, até 7, e eventos para até 23. A partir de R$ 550/noite.">
    <meta name="robots" content="noindex, nofollow">
    <meta property="og:title" content="Domo Xangô · Domo geodésico na Chapada dos Veadeiros">
    <meta property="og:description" content="Uma pausa consciente num domo geodésico de 8 m, em Alto Paraíso de Goiás. A partir de R$ 550/noite.">
    <meta property="og:image" content="{{ absolute_url(asset('media/experience/posters/01_hero-mid.jpg')) }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dosis:wght@300;500&family=Herr+Von+Muellerhoff&display=swap">
    <link rel="preload" as="image" href="{{ asset('media/experience/posters/01_hero-start.jpg') }}">
    <script>
        (function () {
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var save = navigator.connection && navigator.connection.saveData;
            var en = false;
            try { en = localStorage.getItem('domo-xango-lang') === 'en'; } catch (e) {}
            if (en) document.documentElement.lang = 'en';
            if (!reduce && !save) document.documentElement.classList.add('is-scrolly');
        })();
    </script>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/experience.css') }}">
    <script>
        (function () {
            if (!document.documentElement.lang || document.documentElement.lang.indexOf('en') !== 0) return;
            var title = document.querySelector('title');
            if (title && title.dataset.en) title.textContent = title.dataset.en;
            var description = document.querySelector('meta[name="description"]');
            if (description) {
                description.setAttribute('content', 'A private 8 m geodesic dome in Alto Paraíso de Goiás, with a 340 m² deck, a glass pyramid and the Chapada in front of you. Stays for 5 guests, up to 7. Events for up to 23. From R$ 550/night.');
            }
        })();
    </script>
{% endblock %}

{% block importmap %}{{ importmap('experience') }}{% endblock %}

{% block body %}
<main
    class="experience"
    data-controller="experience"
    data-turbo="false"
    data-action="click@window->experience#closeBookOnAway keydown@window->experience#onKey"
>
    <header class="chrome">
        <div class="lang" role="group" aria-label="Idioma / Language">
            <button type="button" data-lang="pt" data-action="experience#setLang" aria-pressed="true">PT</button>
            <span aria-hidden="true">/</span>
            <button type="button" data-lang="en" data-action="experience#setLang" aria-pressed="false">EN</button>
        </div>

        <div class="book" data-experience-target="book">
            <button
                type="button"
                class="pill pill--small"
                aria-expanded="false"
                aria-controls="book-menu"
                data-experience-target="bookButton"
                data-action="experience#toggleBook"
            >
                <span class="t-pt">Reservar</span><span class="t-en">Book</span>
            </button>
            <div id="book-menu" class="book__menu" data-experience-target="bookMenu" hidden>
                <a class="js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
                <a href="{{ links.airbnb }}" target="_blank" rel="noopener noreferrer">Airbnb</a>
            </div>
        </div>

        <a class="skip" href="#reservas">
            <span class="t-pt">Pular para reservas →</span><span class="t-en">Skip to booking →</span>
        </a>

        <a class="pill wa-float js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 3.2A8.7 8.7 0 0 0 4.6 16.4L3.4 20.6l4.3-1.1A8.8 8.8 0 1 0 12 3.2Zm0 1.6a7.1 7.1 0 0 1 0 14.2 7 7 0 0 1-3.6-.9l-.4-.2-2.5.7.7-2.5-.3-.4A7.1 7.1 0 0 1 12 4.8Zm-2.9 3.6c-.2 0-.4 0-.6.3-.2.3-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.5 3.9 3.4 1.9.8 2.3.7 2.7.6.4-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1-.1-.1-.2-.1-.5-.3l-1.3-.6c-.2-.1-.4-.1-.5.1l-.6.7c-.1.1-.2.2-.4.1s-.9-.3-1.7-1.1a6 6 0 0 1-1.2-1.5c-.1-.2 0-.3.1-.4l.4-.5c.1-.1.1-.2.2-.4s0-.3 0-.4l-.6-1.4c-.1-.3-.3-.3-.5-.3h-.5Z"/>
            </svg>
            WhatsApp
        </a>
    </header>

    <div class="story" data-experience-target="story">
        {% for scene in scenes %}
            <section
                class="scene scene--{{ scene.align }}{{ scene.hero ? ' scene--hero is-current' : '' }}{{ scene.finale ? ' scene--finale' : '' }}"
                data-scene="{{ scene.id }}"
                data-experience-target="scene"
                data-travel="{{ scene.travel }}"
                {% if scene.hero %}data-hero="1"{% endif %}
                {% if scene.finale %}data-finale="1"{% endif %}
                aria-label="{{ scene.altPt }}"
                data-alt-pt="{{ scene.altPt }}"
                data-alt-en="{{ scene.altEn }}"
            >
                <div class="scene__pin">
                    <img
                        class="scene__still"
                        src="{{ asset('media/experience/' ~ scene.still) }}"
                        alt="{{ scene.altPt }}"
                        data-alt-pt="{{ scene.altPt }}"
                        data-alt-en="{{ scene.altEn }}"
                        width="1280"
                        height="720"
                        decoding="async"
                        {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                    >
                    <video
                        class="scene__video"
                        data-experience-target="video"
                        data-src="{{ asset('media/experience/' ~ scene.video) }}"
                        poster="{{ asset('media/experience/' ~ scene.poster) }}"
                        muted
                        playsinline
                        preload="none"
                        disablepictureinpicture
                        disableremoteplayback
                        tabindex="-1"
                        aria-hidden="true"
                    ></video>
                    <div class="scene__shade" aria-hidden="true"></div>

                    {% if scene.titlePt or scene.kickerPt or scene.hero or scene.finale %}
                        <div class="scene__copy" data-copy>
                            {% if scene.kickerPt %}
                                <p class="kicker"><span class="t-pt">{{ scene.kickerPt }}</span><span class="t-en">{{ scene.kickerEn }}</span></p>
                            {% endif %}

                            {% if scene.titlePt %}
                                {% if scene.hero %}
                                    <h1 class="script"><span class="t-pt">{{ scene.titlePt }}</span><span class="t-en">{{ scene.titleEn }}</span></h1>
                                {% else %}
                                    <h2 class="script"><span class="t-pt">{{ scene.titlePt }}</span><span class="t-en">{{ scene.titleEn }}</span></h2>
                                {% endif %}
                            {% endif %}

                            {% if scene.bodyPt %}
                                <p class="body"><span class="t-pt">{{ scene.bodyPt }}</span><span class="t-en">{{ scene.bodyEn }}</span></p>
                            {% endif %}

                            {% if scene.pricePt %}
                                <p class="price"><span class="t-pt">{{ scene.pricePt }}</span><span class="t-en">{{ scene.priceEn }}</span></p>
                            {% endif %}
                            {% if scene.metaPt %}
                                <p class="meta"><span class="t-pt">{{ scene.metaPt }}</span><span class="t-en">{{ scene.metaEn }}</span></p>
                            {% endif %}

                            {% if scene.hero or scene.finale %}
                                <a class="pill js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">
                                    <span class="t-pt">RESERVAR O DOMO</span><span class="t-en">BOOK THE DOME</span>
                                </a>
                            {% endif %}

                            {% if scene.finale %}
                                <p class="quiet-links">
                                    <a class="js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">WhatsApp {{ links.phone }}</a>
                                    <span aria-hidden="true">·</span>
                                    <a href="{{ links.airbnb }}" target="_blank" rel="noopener noreferrer">Airbnb</a>
                                </p>
                            {% endif %}

                        </div>
                    {% endif %}
                    {% if scene.finePt %}
                        <p class="fine"><span class="t-pt">{{ scene.finePt }}</span><span class="t-en">{{ scene.fineEn }}</span></p>
                    {% endif %}
                </div>
            </section>
        {% endfor %}
    </div>

    <section id="reservas" class="reservas" data-experience-target="reservas" tabindex="-1">
        <div class="reservas__wrap">
            <div class="reservas__intro">
                <p class="kicker kicker--ink"><span class="t-pt">Um lugar. Todos os ritmos.</span><span class="t-en">One place. Every rhythm.</span></p>
                <h2 class="script script--ink"><span class="t-pt">O domo muda com você.</span><span class="t-en">The dome changes with you.</span></h2>
                <p class="paper-lede">
                    <span class="t-pt">Venha não fazer nada. Ou traga quem você ama e deixe o lugar mudar de forma. Estadia e encontro no mesmo chão: silêncio e celebração, retiro e ritual.</span>
                    <span class="t-en">Come and do nothing at all. Or bring the people you love and let the place change shape. A stay and a gathering on the same ground: silence and celebration, retreat and ritual.</span>
                </p>
                <ul class="pairs">
                    <li><span class="t-pt">Silêncio</span><span class="t-en">Silence</span> <span aria-hidden="true">/</span> <span class="t-pt">Celebração</span><span class="t-en">Celebration</span></li>
                    <li><span class="t-pt">Retiro</span><span class="t-en">Retreat</span> <span aria-hidden="true">/</span> <span class="t-pt">Encontro</span><span class="t-en">Gathering</span></li>
                    <li><span class="t-pt">Íntimo</span><span class="t-en">Intimate</span> <span aria-hidden="true">/</span> <span class="t-pt">Imenso</span><span class="t-en">Immense</span></li>
                    <li><span class="t-pt">Descanso</span><span class="t-en">Rest</span> <span aria-hidden="true">/</span> <span class="t-pt">Ritual</span><span class="t-en">Ritual</span></li>
                </ul>
                <a class="pill js-wa" href="{{ links.eventPt }}" data-wa-pt="{{ links.eventPt }}" data-wa-en="{{ links.eventEn }}" target="_blank" rel="noopener noreferrer">
                    <span class="t-pt">Planejar meu evento</span><span class="t-en">Plan my event</span>
                </a>
                <p class="paper-note">
                    <span class="t-pt">Encontros espirituais, sem álcool, até 23 pessoas. Também um pedido de casamento. Eventos só pelo WhatsApp, direto conosco.</span>
                    <span class="t-en">Spiritual gatherings, no alcohol, up to 23 people. A proposal, too. Events are booked with us directly, on WhatsApp only.</span>
                </p>
            </div>

            <div class="reservas__book">
                <h2 class="script script--ink"><span class="t-pt">Seu lugar na Chapada</span><span class="t-en">Your place in the Chapada</span></h2>
                <p class="paper-price"><span class="t-pt">A partir de R$ 550/noite</span><span class="t-en">From R$ 550/night</span></p>
                <p class="paper-meta"><span class="t-pt">Check-in 14h–18h</span><span class="t-en">Check-in 14:00–18:00</span></p>
                <a class="pill js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">
                    <span class="t-pt">RESERVAR O DOMO</span><span class="t-en">BOOK THE DOME</span>
                </a>
                <p class="paper-links">
                    <a class="js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">WhatsApp {{ links.phone }}</a>
                    <span aria-hidden="true">·</span>
                    <a href="{{ links.airbnb }}" target="_blank" rel="noopener noreferrer">Airbnb</a>
                </p>
            </div>

            <dl class="facts">
                <div>
                    <dt><span class="t-pt">O domo</span><span class="t-en">The dome</span></dt>
                    <dd>
                        <span class="t-pt">Domo geodésico de 8 m. 5 hóspedes, até 7 com uma cama queen extra. Uma queen no domo, outra na pirâmide, e um solteiro.</span>
                        <span class="t-en">An 8 m geodesic dome. 5 guests, up to 7 with an extra queen bed. A queen in the dome, another in the pyramid, and a single.</span>
                    </dd>
                </div>
                <div>
                    <dt><span class="t-pt">O deck</span><span class="t-en">The deck</span></dt>
                    <dd>
                        <span class="t-pt">Cerca de 340 m² de deck privativo, cozinha ao ar livre e a serra inteira à frente.</span>
                        <span class="t-en">About 340 m² of private deck, an open-air kitchen and the whole ridge in front of you.</span>
                    </dd>
                </div>
                <div>
                    <dt><span class="t-pt">A estadia</span><span class="t-en">The stay</span></dt>
                    <dd>
                        <span class="t-pt">A partir de R$ 550/noite. Check-in 14h–18h. Reserve pelo WhatsApp ou pelo Airbnb.</span>
                        <span class="t-en">From R$ 550/night. Check-in 14:00–18:00. Book on WhatsApp or on Airbnb.</span>
                    </dd>
                </div>
                <div>
                    <dt><span class="t-pt">Eventos</span><span class="t-en">Events</span></dt>
                    <dd>
                        <span class="t-pt">Somente direto pelo WhatsApp. Encontros espirituais, sem álcool, até 23 pessoas. Também para um pedido de casamento.</span>
                        <span class="t-en">Direct on WhatsApp only. Spiritual gatherings, no alcohol, up to 23 people. A proposal, too.</span>
                    </dd>
                </div>
                <div>
                    <dt><span class="t-pt">Extras, à parte</span><span class="t-en">Extras, not included</span></dt>
                    <dd>
                        <span class="t-pt">Café da manhã, massagens e terapias pelo Rajaaram, e transfers. Não estão no valor da diária.</span>
                        <span class="t-en">Breakfast, massages and therapies through Rajaaram, and transfers. They are not included in the nightly rate.</span>
                        <a class="text-link js-wa" href="{{ links.massagePt }}" data-wa-pt="{{ links.massagePt }}" data-wa-en="{{ links.massageEn }}" target="_blank" rel="noopener noreferrer">
                            <span class="t-pt">Agendar massagem</span><span class="t-en">Book a massage</span>
                        </a>
                    </dd>
                </div>
                <div>
                    <dt><span class="t-pt">Por perto</span><span class="t-en">Around you</span></dt>
                    <dd>
                        <span class="t-pt">O Rajaaram faz parte da propriedade. A cachoeira Anjos e Arcanjos fica a cerca de 10 minutos — não é o Rajaaram.</span>
                        <span class="t-en">Rajaaram is part of the property. The Anjos e Arcanjos waterfall is about 10 minutes away — it is not Rajaaram.</span>
                        <a class="text-link" href="{{ links.rajaaram }}" target="_blank" rel="noopener noreferrer">rajaaram.com.br</a>
                    </dd>
                </div>
            </dl>

            <figure class="quote">
                <blockquote>The Best View in the World.</blockquote>
                <figcaption>TripAdvisor</figcaption>
            </figure>

            <p class="colophon">Domo Xangô · Alto Paraíso de Goiás · Chapada dos Veadeiros</p>
        </div>
    </section>
</main>
{% endblock %}
