{% extends 'base.html.twig' %}

{% block title %}Domo Xangô · A melhor vista do mundo | Chapada dos Veadeiros{% endblock %}
{% block title_attrs %} data-pt="Domo Xangô · A melhor vista do mundo | Chapada dos Veadeiros" data-en="Domo Xangô · The best view in the world | Chapada dos Veadeiros"{% endblock %}

{% block meta %}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="A melhor vista do mundo. Domo geodésico privativo em Alto Paraíso de Goiás, na Chapada dos Veadeiros. A partir de R$ 550/noite." data-pt="A melhor vista do mundo. Domo geodésico privativo em Alto Paraíso de Goiás, na Chapada dos Veadeiros. A partir de R$ 550/noite." data-en="The best view in the world. A private geodesic dome in Alto Paraíso de Goiás, Chapada dos Veadeiros. From R$ 550/night.">
    <link rel="canonical" href="{{ url('experience_home') }}">
    <meta property="og:url" content="{{ url('experience_home') }}">
    <meta property="og:title" content="Domo Xangô · A melhor vista do mundo | Chapada dos Veadeiros">
    <meta property="og:description" content="A melhor vista do mundo. Domo geodésico privativo em Alto Paraíso de Goiás, na Chapada dos Veadeiros.">
    <meta property="og:image" content="{{ absolute_url(asset('media/experience/posters/01_hero-mid.jpg')) }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dosis:wght@300;500&family=Herr+Von+Muellerhoff&display=swap">
    <link rel="preload" as="image" href="{{ asset('media/experience/posters/01_hero-start.jpg') }}">
    <script>
        (function () {
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var save = navigator.connection && navigator.connection.saveData;
            var en = false;
            try { en = localStorage.getItem('domo-xango-lang') === 'en'; } catch (e) {}
            if (en) document.documentElement.lang = 'en';
            if (!reduce && !save) document.documentElement.classList.add('is-scrolly');
        })();
    </script>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/experience.css') }}">
    <script>
        (function () {
            if (!document.documentElement.lang || document.documentElement.lang.indexOf('en') !== 0) return;
            var title = document.querySelector('title');
            if (title && title.dataset.en) title.textContent = title.dataset.en;
            var description = document.querySelector('meta[name="description"]');
            if (description && description.dataset.en) description.setAttribute('content', description.dataset.en);
        })();
    </script>
{% endblock %}

{% block importmap %}{{ importmap('experience') }}{% endblock %}

{% block body %}
<main
    class="experience"
    data-controller="experience"
    data-turbo="false"
    data-action="click@window->experience#closeBookOnAway keydown@window->experience#onKey"
>
    <header class="chrome">
        <div class="lang" role="group" aria-label="Idioma / Language">
            <button type="button" data-lang="pt" data-action="experience#setLang" aria-pressed="true">PT</button>
            <span aria-hidden="true">/</span>
            <button type="button" data-lang="en" data-action="experience#setLang" aria-pressed="false">EN</button>
        </div>

        <div class="top-actions">
            <a class="pill pill--small pill--ghost" href="{{ links.concierge }}" target="_blank" rel="noopener noreferrer">Concierge</a>
            <div class="book" data-experience-target="book">
                <button
                    type="button"
                    class="pill pill--small"
                    aria-expanded="false"
                    aria-controls="book-menu"
                    data-experience-target="bookButton"
                    data-action="experience#toggleBook"
                >
                    <span class="t-pt">Reservar</span><span class="t-en">Book</span>
                </button>
                <div id="book-menu" class="book__menu" data-experience-target="bookMenu" hidden>
                    <a class="js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
                    <a href="{{ links.airbnb }}" target="_blank" rel="noopener noreferrer">Airbnb</a>
                </div>
            </div>
        </div>

        <a class="skip" href="#reservas">
            <span class="t-pt">Pular para reservas →</span><span class="t-en">Skip to booking →</span>
        </a>

        <a class="pill wa-float js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 3.2A8.7 8.7 0 0 0 4.6 16.4L3.4 20.6l4.3-1.1A8.8 8.8 0 1 0 12 3.2Zm0 1.6a7.1 7.1 0 0 1 0 14.2 7 7 0 0 1-3.6-.9l-.4-.2-2.5.7.7-2.5-.3-.4A7.1 7.1 0 0 1 12 4.8Zm-2.9 3.6c-.2 0-.4 0-.6.3-.2.3-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.5 3.9 3.4 1.9.8 2.3.7 2.7.6.4-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1-.1-.1-.2-.1-.5-.3l-1.3-.6c-.2-.1-.4-.1-.5.1l-.6.7c-.1.1-.2.2-.4.1s-.9-.3-1.7-1.1a6 6 0 0 1-1.2-1.5c-.1-.2 0-.3.1-.4l.4-.5c.1-.1.1-.2.2-.4s0-.3 0-.4l-.6-1.4c-.1-.3-.3-.3-.5-.3h-.5Z"/>
            </svg>
            WhatsApp
        </a>
    </header>

    <div class="story" data-experience-target="story">
        {% for beat in beats %}
            {% if beat.type == 'hub' %}
                {% set hub = beat.hub %}
                <section class="hub" id="{{ hub.id }}" data-hub>
                    <div class="hub__inner">
                        <h2 class="script hub__title"><span class="t-pt">{{ hub.titlePt }}</span><span class="t-en">{{ hub.titleEn }}</span></h2>
                        <div class="hub__cards">
                            {% for card in hub.cards %}
                                <a class="hub-card" href="{{ card.href }}">
                                    <img src="{{ asset('media/experience/' ~ card.image) }}" alt="{{ card.altPt }}" data-alt-pt="{{ card.altPt }}" data-alt-en="{{ card.altEn }}" width="640" height="360" loading="lazy" decoding="async">
                                    <span class="hub-card__title"><span class="t-pt">{{ card.titlePt }}</span><span class="t-en">{{ card.titleEn }}</span></span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                </section>
            {% else %}
                {% set scene = beat.scene %}
            <section
                class="scene scene--{{ scene.align }}{{ scene.hero ? ' scene--hero is-current' : '' }}{{ scene.finale ? ' scene--finale' : '' }}{{ scene.placeholder ? ' scene--placeholder' : '' }}"
                id="{{ scene.anchor ?: scene.id }}"
                data-scene="{{ scene.id }}"
                data-experience-target="scene"
                data-travel="{{ scene.travel }}"
                {% if scene.hero %}data-hero="1"{% endif %}
                {% if scene.finale %}data-finale="1"{% endif %}
                {% if scene.brief %}data-brief="1"{% endif %}
                {% if scene.placeholder %}data-placeholder="bath"{% endif %}
                aria-label="{{ scene.altPt }}"
                data-alt-pt="{{ scene.altPt }}"
                data-alt-en="{{ scene.altEn }}"
            >
                <div class="scene__pin">
                    <img
                        class="scene__still"
                        src="{{ asset('media/experience/' ~ scene.still) }}"
                        alt="{{ scene.altPt }}"
                        data-alt-pt="{{ scene.altPt }}"
                        data-alt-en="{{ scene.altEn }}"
                        width="1280"
                        height="720"
                        decoding="async"
                        {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                    >
                    {% if scene.video %}
                    <video
                        class="scene__video"
                        data-experience-target="video"
                        data-src="{{ asset('media/experience/' ~ scene.video) }}"
                        poster="{{ asset('media/experience/' ~ scene.poster) }}"
                        muted
                        playsinline
                        preload="none"
                        disablepictureinpicture
                        disableremoteplayback
                        tabindex="-1"
                        aria-hidden="true"
                    ></video>
                    {% endif %}
                    <div class="scene__shade" aria-hidden="true"></div>

                    {% if scene.titlePt or scene.bodyPt or scene.kickerPt or scene.hero or scene.finale or scene.backHub %}
                        <div class="scene__copy" data-copy>
                            {% if scene.kickerPt %}
                                <p class="kicker"><span class="t-pt">{{ scene.kickerPt }}</span><span class="t-en">{{ scene.kickerEn }}</span></p>
                            {% endif %}

                            {% if scene.hero %}
                                <p class="view-line"><span class="t-pt">A melhor vista do mundo</span><span class="t-en">The best view in the world</span></p>
                            {% endif %}

                            {% if scene.titlePt %}
                                {% if scene.hero %}
                                    <h1 class="script"><span class="t-pt">{{ scene.titlePt }}</span><span class="t-en">{{ scene.titleEn }}</span></h1>
                                {% else %}
                                    <h2 class="script"><span class="t-pt">{{ scene.titlePt }}</span><span class="t-en">{{ scene.titleEn }}</span></h2>
                                {% endif %}
                            {% endif %}

                            {% if scene.bodyPt %}
                                <p class="body"><span class="t-pt">{{ scene.bodyPt }}</span><span class="t-en">{{ scene.bodyEn }}</span></p>
                            {% endif %}
                            {% if scene.smallPt %}
                                <p class="small"><span class="t-pt">{{ scene.smallPt }}</span><span class="t-en">{{ scene.smallEn }}</span></p>
                            {% endif %}
                            {% if scene.noticePt %}
                                <p class="notice"><span class="t-pt">{{ scene.noticePt }}</span><span class="t-en">{{ scene.noticeEn }}</span></p>
                            {% endif %}

                            {% if scene.pricePt %}
                                <p class="price"><span class="t-pt">{{ scene.pricePt }}</span><span class="t-en">{{ scene.priceEn }}</span></p>
                            {% endif %}
                            {% if scene.metaPt %}
                                <p class="meta"><span class="t-pt">{{ scene.metaPt }}</span><span class="t-en">{{ scene.metaEn }}</span></p>
                            {% endif %}

                            {% if scene.hero or scene.finale %}
                                <a class="pill js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">
                                    <span class="t-pt">RESERVAR O DOMO</span><span class="t-en">BOOK THE DOME</span>
                                </a>
                            {% endif %}

                            {% if scene.finale %}
                                <p class="quiet-links">
                                    <a class="js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">WhatsApp {{ links.phone }}</a>
                                    <span aria-hidden="true">·</span>
                                    <a href="{{ links.airbnb }}" target="_blank" rel="noopener noreferrer">Airbnb</a>
                                </p>
                            {% endif %}
                            {% if scene.id == 'gatherings' %}
                                <p class="quiet-links">
                                    <a class="js-wa" href="{{ links.eventPt }}" data-wa-pt="{{ links.eventPt }}" data-wa-en="{{ links.eventEn }}" target="_blank" rel="noopener noreferrer"><span class="t-pt">Reservar pelo WhatsApp</span><span class="t-en">Book on WhatsApp</span></a>
                                </p>
                            {% endif %}
                            {% if scene.backHub %}
                                <p class="chapter-nav">
                                    <a href="#{{ scene.backHub }}"><span class="t-pt">Ver outro canto ↺</span><span class="t-en">See another corner ↺</span></a>
                                    <a href="{{ scene.nextHref }}"><span class="t-pt">Seguir a jornada →</span><span class="t-en">Continue the journey →</span></a>
                                </p>
                            {% endif %}

                        </div>
                    {% endif %}
                    {% if scene.finePt %}
                        <p class="fine"><span class="t-pt">{{ scene.finePt }}</span><span class="t-en">{{ scene.fineEn }}</span></p>
                    {% endif %}
                </div>
            </section>
            {% endif %}
        {% endfor %}
    </div>

    <section id="reservas" class="reservas" data-experience-target="reservas" tabindex="-1">
        <div class="reservas__wrap">
            <div class="reservas__book">
                <h2 class="script script--ink"><span class="t-pt">Seu lugar na Chapada</span><span class="t-en">Your place in Chapada</span></h2>
                <p class="paper-lede">
                    <span class="t-pt">Aqui você não só se hospeda. Você desacelera, respira fundo e lembra do que importa.</span>
                    <span class="t-en">Here you don't just stay. You slow down, breathe deeply and remember what matters.</span>
                </p>
                <p class="paper-price"><span class="t-pt">A partir de R$ 550/noite</span><span class="t-en">From R$ 550/night</span></p>
                <p class="paper-meta"><span class="t-pt">Check-in 14h–18h · 5 hóspedes (até 7 com cama queen extra)</span><span class="t-en">Check-in 2–6 pm · 5 guests (up to 7 with an extra queen bed)</span></p>
                <a class="pill js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">
                    <span class="t-pt">RESERVAR O DOMO</span><span class="t-en">BOOK THE DOME</span>
                </a>
                <p class="paper-links">
                    <a class="js-wa" href="{{ links.stayPt }}" data-wa-pt="{{ links.stayPt }}" data-wa-en="{{ links.stayEn }}" target="_blank" rel="noopener noreferrer">WhatsApp {{ links.phone }}</a>
                    <span aria-hidden="true">·</span>
                    <a href="{{ links.airbnb }}" target="_blank" rel="noopener noreferrer">Airbnb</a>
                </p>
            </div>

            <dl class="facts">
                <div>
                    <dt><span class="t-pt">Incluso</span><span class="t-en">Included</span></dt>
                    <dd>
                        <span class="t-pt">Domo e pirâmide exclusivos, deck de 340 m², cozinha equipada, banheiro privativo, Wi-Fi, estacionamento.</span>
                        <span class="t-en">Exclusive dome and pyramid, 340 m² deck, equipped kitchen, private bathroom, Wi-Fi, parking.</span>
                    </dd>
                </div>
                <div>
                    <dt><span class="t-pt">Sob pedido</span><span class="t-en">On request</span></dt>
                    <dd>
                        <span class="t-pt">Café da manhã no Kuya Deck, massagens no Rajaaram, transfer.</span>
                        <span class="t-en">Breakfast at Kuya Deck, massages at Rajaaram, transfer.</span>
                        <a class="text-link js-wa" href="{{ links.massagePt }}" data-wa-pt="{{ links.massagePt }}" data-wa-en="{{ links.massageEn }}" target="_blank" rel="noopener noreferrer">
                            <span class="t-pt">Agendar massagem</span><span class="t-en">Book a massage</span>
                        </a>
                    </dd>
                </div>
                <div>
                    <dt><span class="t-pt">Bom saber</span><span class="t-en">Good to know</span></dt>
                    <dd>
                        <span class="t-pt">14 km de Alto Paraíso, carro alto recomendado, trilha de 100 m; não recomendado para crianças pequenas (deck sem guarda-corpo). Visitas somente com reserva confirmada. Por favor, não venha sem agendar.</span>
                        <span class="t-en">14 km from Alto Paraíso, high-clearance car recommended, 100 m path; not recommended for young children (deck without railings). Visits by confirmed reservation only. Please don't arrive without booking.</span>
                    </dd>
                </div>
            </dl>

            <p class="colophon">Domo Xangô · Alto Paraíso de Goiás · Chapada dos Veadeiros</p>
        </div>
    </section>
</main>
{% endblock %}
